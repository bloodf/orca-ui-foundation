{
  "name": "@orca-plugins/ui-foundation",
  "version": "5.6.0",
  "private": true,
  "type": "module",
  "description": "Shared Vue 3 and PrimeVue 5 visual foundation for Orca plugins",
  "license": "MIT",
  "repository": "github:bloodf/orca-ui-foundation",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "scripts/vue-tsc.mjs",
    "licenses",
    "manifest.json",
    "DESIGN.md",
    "MIGRATION-5.0.md"
  ],
  "scripts": {
    "build": "node scripts/icons.mjs && node scripts/vue-tsc.mjs --noEmit && vite build && node scripts/manifest.mjs",
    "check": "node scripts/check.mjs && node --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "@primeuix/themes": "3.1.1",
    "primevue": "5.0.5",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@primeuix/themes": "3.1.1",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.11",
    "lucide-static": "1.77.0",
    "primevue": "5.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  }
}
